---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import {
  Zap, Lock, Globe, Cpu, Layers, Activity, CheckCircle
} from "@lucide/astro";

const featureModules = [
  {
    icon: Zap,
    title: "企业级 IEPL 物理专线架构",
    desc: "采用点对点物理光缆内网直连（IEPL），数据完全避开公网国际骨干出口。晚高峰时段全国网络发生拥堵时，专线通道始终享有高保障带宽，实现 0 丢包与毫秒级极速直达。",
    points: [
      "沪港、深港、京德专线物理链路端到端传输",
      "全链路抖动 < 3ms，晚高峰持续稳定不卡顿",
      "单节点最高支持 2.5Gbps 超大吞吐能力",
      "全天候双路热备自动倒换容灾保护"
    ],
  },
  {
    icon: Lock,
    title: "新一代 VLESS 协议抗封锁体系",
    desc: "全面拥抱更安全、更现代的 VLESS 传输协议，去除传统旧协议冗余复杂的 TLS-in-TLS 多层封包开销，天然具备抗深度数据包检测（DPI）特性与更轻的握手延迟。",
    points: [
      "轻量级协议头设计，握手握联提速 40%",
      "高度拟真正常 Web 流量特征，抗阻断能力卓越",
      "全链路 AEAD 现代高强度双向加密验证",
      "兼容各种网络环境，长期保活不掉线"
    ],
  },
  {
    icon: Globe,
    title: "原生住宅与商宽 IP 资源矩阵",
    desc: "精选落地机房原生住宅与高质量商业宽带 IP，彻底告别普通广播级机房共享 IP 的风控拦截，完美赋能 AI 智能体开发、跨境出海直播与海外流媒体解锁。",
    points: [
      "支持 ChatGPT、Claude、Midjourney 深度会话无风控",
      "解锁 Netflix 4K HDR、Disney+、YouTube 超清画质",
      "支持 TikTok 欧美东南亚跨境直播与店铺运营",
      "原生 IP 定期健康轮巡，保障低风险值环境"
    ],
  },
  {
    icon: Layers,
    title: "双轨客户端支持：官方自研 + 通用生态",
    desc: "为兼顾新手小白与技术极客的不同需求，既提供跨平台官方自研客户端一键直连，又完整支持标准订阅链接导出，与全球主流开源客户端生态完美共融。",
    points: [
      "官方自研客户端：Windows / macOS / Android / iOS 一键登录直连",
      "全兼容开源生态：Clash Verge、Shadowrocket、Surge、v2rayN、Sing-box",
      "支持一键订阅自动更新节点与智能测速分流",
      "全站套餐均不限制并发设备连接数量"
    ],
  },
  {
    icon: Cpu,
    title: "全节点 ×1 真实倍率承诺",
    desc: "坚决抵制业内不良商家使用 2x-5x 暗扣倍率掠夺流量的行为。在 NordVPN 官方专线站，所有专线节点统一标注真实 1x 倍率，每一兆流量都实打实用于业务传输。",
    points: [
      "全节点 1x 计费，无任何隐形倍率换算",
      "控制台实时同步流量使用统计图表",
      "套餐用量透明可溯，无任何峰谷期差异扣费",
      "提供年付让利与一次性永久版多种选择"
    ],
  },
  {
    icon: Activity,
    title: "7×24 小时 SLA 专线高可用保障",
    desc: "自动化运维系统每隔 10 秒对全球专线节点发起真实端到端探测。一旦监测到某地区光纤波动，调度网关将在 30 秒内无感热切至同地区备用节点，保障业务不掉线。",
    points: [
      "SLA 服务可用性指标达 99.98% 以上",
      "分布式双活机房布局，节点永不全线中断",
      "全天候专属网络运维值班与工单响应",
      "提供企业级物理独享线路与专属原生 IP 部署"
    ],
  },
];
---

<Layout
  title={`专线技术与产品优势 — ${siteConfig.title}`}
  description="深度解析 NordVPN 官方授权专线站的企业级 IEPL 物理专线、VLESS 现代协议、原生住宅 IP 与全节点 1x 真实倍率。"
>
  <section class="site-container my-12">
    <PageHeader
      title="核心专线技术架构与产品优势"
      description="了解我们如何通过物理专线、现代加密协议与原生住宅 IP，为用户重塑极致流畅的出海互联体验。"
    />
  </section>

  <!-- Feature Modules Detail Cards -->
  <section class="site-container max-w-5xl mx-auto pb-24 space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featureModules.map((m, i) => (
        <div
          class="p-6 sm:p-8 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 dark:border-neutral-700 hover:border-primary/40 hover:shadow-lg transition-all"
          data-aos="fade-up-sm"
          data-aos-delay={i * 80}
          data-aos-once="true"
        >
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-lighter flex-shrink-0">
              <m.icon class="w-5 h-5" />
            </div>
            <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
              {m.title}
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
            {m.desc}
          </p>
          <ul class="space-y-2 border-t border-dashed border-neutral-200 dark:border-neutral-700/80 pt-4 text-xs">
            {m.points.map((pt) => (
              <li class="flex items-start gap-2 text-neutral-600 dark:text-neutral-300">
                <CheckCircle class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- SLA Section -->
    <div id="sla" class="p-8 rounded-2xl bg-gradient-to-r from-bg-secondary to-blue-50/20 dark:from-bg-secondary-dark dark:to-blue-950/20 border border-primary/20">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 mb-2">
            SLA 服务承诺
          </span>
          <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
            99.98% 专线网络可用性保障
          </h3>
          <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 max-w-xl">
            我们对每一条 IEPL 物理专线进行全天候可用性追踪。无论是跨国学术研讨、关键外贸洽谈还是长程 AI 生成，网络稳定性始终是我们最重视的底线。
          </p>
        </div>
        <Button url={siteConfig.registerUrl} target="_blank" rel="nofollow sponsored noopener noreferrer" type="fill" className="whitespace-nowrap">
          <Zap class="w-4 h-4 text-accent" /> 开通专线服务
        </Button>
      </div>
    </div>
  </section>
</Layout>
