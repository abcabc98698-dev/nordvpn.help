---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import PricingSection from "@/components/sections/Pricing.astro";
import AccordionItem from "@/components/ui/AccordionItem.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { Zap } from "@lucide/astro";

const comparisonFeatures = [
  { name: "流量规格", snooker: "247GB 永久有效", light: "69GB / 月", speed: "168GB / 月", custom: "500GB / 月 (可扩容)" },
  { name: "价格与计费", snooker: "¥147 一次性", light: "¥99 / 年 (约¥8.25/月)", speed: "¥25 / 月 (年付8折)", custom: "¥680 / 月 (独享资源)" },
  { name: "专线类型", snooker: "原生稳定专线", light: "原生稳定节点", speed: "全球 IPLC/IEPL 专线", custom: "按需独立部署物理专线" },
  { name: "节点倍率", snooker: "全节点 ×1", light: "全节点 ×1", speed: "全节点 ×1", custom: "独享物理带宽" },
  { name: "连接速率上限", snooker: "最高 2.5Gbps", light: "最高 2.5Gbps", speed: "最高 2.5Gbps", custom: "最高 2.5Gbps 独立带宽" },
  { name: "设备连接限制", snooker: "不限并发设备", light: "不限并发设备", speed: "不限并发设备", custom: "不限并发设备 (团队协同)" },
  { name: "节点覆盖区域", snooker: "香港/台湾/日本/新加坡/欧美等", light: "港台日新美德法英等11国", speed: "港台日新美德法英等11国", custom: "全球核心数据中心灵活自选" },
  { name: "AI 场景解锁", snooker: "ChatGPT/Claude/Midjourney", light: "ChatGPT 基础解锁", speed: "AI 深度对话全天候畅通", custom: "专属纯净 IP 防风控" },
  { name: "4K/8K 流媒体", snooker: "轻度至高清", light: "Netflix / Disney+ / TikTok", speed: "Netflix 4K / YouTube 8K / TikTok", custom: "TikTok 高清直播推流专用" },
  { name: "运维支持级别", snooker: "7×12h 技术支持", light: "7×12h 技术支持", speed: "7×24h 专线运维监控", custom: "7×24h 一对一技术顾问" },
];

const pricingFaq = [
  {
    question: "8.25 元/月的套餐是如何计算的？",
    answer: "8.25 元/月是【轻量版】按年付费（99 元/年）折算后的平均月成本，每年提供每月 69GB 稳定流量。该套餐非常适合日常轻度视频、ChatGPT 查询、资料查阅及社交聊天的用户。"
  },
  {
    question: "【致敬斯诺克147永久套餐】真的永久有效吗？",
    answer: "是的！该套餐为一次性买断制，总计提供 247GB 永久有效流量，永不过期，用完即止。单节点最高 2.5Gbps，覆盖香港、台湾、日本、新加坡、欧美等多国原生节点，是外贸备用、轻量办公与商务差旅的最佳选择。"
  },
  {
    question: "【极速版】的多周期折扣如何计算？",
    answer: "极速版支持灵活周期订阅：月付 25 元；半年付享 9 折（¥135）；年付享 8 折（¥240/年，折合每月仅 20 元）；两年付享 75 折；三年付享 7 折。全节点固定 ×1 倍率计费，绝无晚高峰暗扣套路。"
  },
  {
    question: "【定制版】支持哪些企业级业务？",
    answer: "定制版专为跨境电商多店铺运营、TikTok 海外高清直播带货、跨国远程办公及外贸团队打造。我们为每位客户单独分配专属原生住宅/商宽 IP 与独立物理带宽，一对一确认接入地区，彻底规避平台风控关联风险。"
  }
];
---

<Layout
  title={`套餐与定价 — ${siteConfig.title}`}
  description="NordVPN 官方授权专线套餐详情与横向对比，包括147永久套餐、年付轻量版、极速版及企业定制版。"
>
  <section class="site-container my-12">
    <PageHeader
      title="官方认证套餐方案 · 细致对比"
      description="全节点 IEPL 专线，全节点 ×1 真实倍率，全周期无虚标。根据您的实际使用频次与带宽需求自由选择。"
    />
  </section>

  <!-- 4-Card Pricing Grid -->
  <PricingSection showHeader={false} />

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-8 site-container"></div>

  <!-- Detailed Feature Comparison Table -->
  <section class="site-container py-14 md:py-20" data-aos="fade-up-xs" data-aos-once="true">
    <h2 class="text-2xl sm:text-3xl font-brand font-bold text-center mb-4 text-neutral-900 dark:text-neutral-100">
      全套餐技术与权益横向对比
    </h2>
    <p class="text-center text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mb-10 max-w-xl mx-auto">
      所有套餐均包含官方跨平台自研客户端使用权，支持一键导入 Clash、Shadowrocket 等主流第三方工具。
    </p>

    <div class="max-w-5xl mx-auto overflow-x-auto rounded-2xl border border-neutral-200 dark:border-neutral-700 bg-bg-secondary dark:bg-bg-secondary-dark">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead>
          <tr class="border-b border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50">
            <th class="py-4 px-4 font-bold text-neutral-800 dark:text-neutral-200">对比维度</th>
            <th class="py-4 px-3 font-semibold text-neutral-700 dark:text-neutral-300">147永久套餐</th>
            <th class="py-4 px-3 font-semibold text-neutral-700 dark:text-neutral-300">轻量版</th>
            <th class="py-4 px-3 font-bold text-primary dark:text-primary-light">极速版 (主力推荐)</th>
            <th class="py-4 px-3 font-semibold text-neutral-700 dark:text-neutral-300">企业定制版</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
          {comparisonFeatures.map((row) => (
            <tr class="hover:bg-neutral-50/50 dark:hover:bg-neutral-800/30 transition-colors">
              <td class="py-3.5 px-4 font-medium text-neutral-800 dark:text-neutral-200">{row.name}</td>
              <td class="py-3.5 px-3 text-neutral-600 dark:text-neutral-300">{row.snooker}</td>
              <td class="py-3.5 px-3 text-neutral-600 dark:text-neutral-300">{row.light}</td>
              <td class="py-3.5 px-3 font-semibold text-primary dark:text-primary-lighter">{row.speed}</td>
              <td class="py-3.5 px-3 text-neutral-600 dark:text-neutral-300">{row.custom}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Pricing FAQ -->
  <section class="py-14 md:py-20 site-container">
    <h2 class="text-2xl sm:text-3xl font-brand font-bold text-center mb-8 text-neutral-900 dark:text-neutral-100">
      套餐选购常见疑问
    </h2>
    <div class="max-w-3xl mx-auto space-y-3" data-aos="fade-up-xs" data-aos-once="true">
      {pricingFaq.map((item, index) => (
        <AccordionItem question={item.question} answer={item.answer} index={index} />
      ))}
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-12 md:py-18 site-container rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/20 text-center" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-xl mx-auto px-4">
      <h2 class="text-2xl font-bold font-brand text-neutral-900 dark:text-neutral-100 mb-3">
        立即开通专属专线订阅
      </h2>
      <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mb-6">
        年付低至 8.25 元/月，30 秒完成授权，全平台客户端与通用订阅即刻生效。
      </p>
      <div class="flex justify-center gap-3">
        <Button url={siteConfig.registerUrl} type="fill" target="_blank" rel="nofollow sponsored noopener noreferrer">
          <Zap class="w-4 h-4 text-accent" /> 立即注册开通
        </Button>
        <Button url="/contact" type="solid">
          咨询在线客服
        </Button>
      </div>
    </div>
  </section>
</Layout>
