---
import { getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Toc from '@/components/widgets/Toc.astro';
import { siteConfig } from "@/config/site";
import { ShieldCheck } from "@lucide/astro";

// SSG 模式下的动态路由需要使用 getStaticPaths()
// 来告诉 Astro 在构建时生成哪些页面
export async function getStaticPaths() {
	const postEntries = await getCollection("post");
	return postEntries.map((entry) => {
		const slugString = entry.id;
		return {
			params: { slug: slugString },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;

if (!entry) {
	return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);
const filtered = headings.filter(h => h.depth <= 2);

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${siteConfig.url}/blog/${entry.id}/#article`,
      "isPartOf": {
        "@type": "WebPage",
        "@id": `${siteConfig.url}/blog/${entry.id}/`
      },
      "headline": entry.data.title,
      "description": entry.data.description,
      "image": entry.data.img ? `${siteConfig.url}${entry.data.img}` : `${siteConfig.url}/og.jpg`,
      "datePublished": entry.data.publishDate.toISOString(),
      "dateModified": entry.data.publishDate.toISOString(),
      "mainEntityOfPage": `${siteConfig.url}/blog/${entry.id}/`,
      "author": {
        "@type": "Organization",
        "name": "NordVPN 网络工程架构组",
        "url": siteConfig.url
      },
      "publisher": {
        "@type": "Organization",
        "name": "NordVPN 官方授权服务站",
        "logo": {
          "@type": "ImageObject",
          "url": `${siteConfig.url}/favicon.png`
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${siteConfig.url}/blog/${entry.id}/#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": `${siteConfig.url}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "使用教程与技术指南",
          "item": `${siteConfig.url}/blog/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": entry.data.title,
          "item": `${siteConfig.url}/blog/${entry.id}/`
        }
      ]
    }
  ]
};
---

<PostLayout
	title={`${entry.data.title} — ${siteConfig.title}`}
	description={entry.data.description}
	ogType="article"
	publishedTime={entry.data.publishDate}
	modifiedTime={entry.data.updatedDate || entry.data.publishDate}
	author={entry.data.author || "NordVPN 网络工程架构组"}
	tags={entry.data.tags}
	category={entry.data.category || "专线技术实战"}
	ogImage={entry.data.img ? (entry.data.img.startsWith('http') ? entry.data.img : `${siteConfig.url}${entry.data.img}`) : `${siteConfig.url}/og.jpg`}
>
	<!-- Article JSON-LD Structured Data (Schema.org) -->
	<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

	<!-- Reading progress bar -->
	<div id="reading-progress" class="reading-progress" style="transform: scaleX(0);"></div>

	<div class="post article">
		<main class="relative site-container mx-auto my-8 md:my-12">
			<!-- Article header -->
			<header class="article-header">
				<!-- Tags -->
				<div class="article-tags">
					{entry.data.tags && entry.data.tags.length > 0 ? (
						entry.data.tags.map(tag => (
							<span class="article-tag letter-spacing-wide text-xs">{tag}</span>
						))
					) : (
						<span class="article-tag text-xs">Article</span>
					)}
				</div>

				<!-- Title -->
				<h1 class="article-title font-brand">
					{entry.data.title}
				</h1>

				<!-- Metadata -->
				<div class="article-meta text-sm text-neutral-500 dark:text-neutral-400">
					<time datetime={entry.data.publishDate.toISOString()}>
						{entry.data.publishDate.toLocaleDateString('zh-CN', {
							year: 'numeric',
							month: 'long',
							day: 'numeric'
						})}
					</time>
					{entry.data.read && (
						<>
							<span class="article-meta-divider"></span>
							<span>{entry.data.read} 分钟阅读</span>
						</>
					)}
				</div>

				<!-- Author & EEAT Credential Badge -->
				<div class="flex items-center gap-3 mt-4 pt-4 border-t border-dashed border-primary/20 text-xs text-neutral-600 dark:text-neutral-300">
					<div class="w-8 h-8 rounded-full bg-primary/10 border border-primary/30 flex items-center justify-center text-primary font-bold shrink-0">
						<ShieldCheck class="w-4 h-4" />
					</div>
					<div>
						<div class="flex items-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100">
							<span>NordVPN 网络工程架构组</span>
							<span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
								官方技术实测认证
							</span>
						</div>
						<p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">
							2020年起专注企业级 IEPL 专线网络与国际路由优化 · 真实物理链路实测
						</p>
					</div>
				</div>
			</header>
			</header>

			<!-- Content area -->
			<div class="relative flex flex-col lg:flex-row gap-8 lg:gap-12 xl:gap-16">
				<!-- Left TOC - Fixed on desktop -->
				<aside class="relative hidden lg:block lg:w-40 xl:w-50 flex-shrink-0">
					<div class="toc-sticky-wrapper">
						<Toc headings={filtered} />
					</div>
				</aside>

				<!-- Article content -->
				<div class="relative flex-1 min-w-0 w-full lg:max-w-none">
					<article class="article-wrapper">
						<div class="article-content">
							<Content />
						</div>
					</article>
				</div>
			</div>
		</main>
	</div>
</PostLayout>

<style>
.toc-sticky-wrapper {
  position: sticky;
  top: 8rem;
}
</style>

<script>
// Reading progress bar
function updateReadingProgress() {
  const progressBar = document.getElementById('reading-progress');
  if (!progressBar) return;

  const windowHeight = window.innerHeight;
  const documentHeight = document.documentElement.scrollHeight;
  const scrollTop = window.scrollY;
  const scrollPercentage = (scrollTop / (documentHeight - windowHeight)) * 100;

  progressBar.style.transform = `scaleX(${Math.min(scrollPercentage / 100, 1)})`;
}

// Event listener
window.addEventListener('scroll', updateReadingProgress, { passive: true });

// Initialize
document.addEventListener('DOMContentLoaded', updateReadingProgress);
updateReadingProgress();
</script>

