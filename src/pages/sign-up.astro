---
import { ArrowRight, Lock, ShieldCheck, Zap, Sparkles, CheckCircle } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title={`快速注册开通 — ${siteConfig.title}`}
  description="创建您的 NordVPN 官方专线账户，30秒即刻开通企业级 IEPL 专线与 VLESS 高速订阅，全平台客户端一键直连。"
>
  <main class="site-container py-12 md:py-20">
    <section class="grid min-h-[calc(100vh-18rem)] items-center gap-10 lg:grid-cols-[minmax(440px,1.1fr)_minmax(0,0.9fr)]">
      <!-- Left: Conversion Gateway Box -->
      <div
        class="mx-auto w-full max-w-lg lg:order-first"
        data-aos="fade-up-xs"
        data-aos-once="true"
      >
        <div class="rounded-3xl border border-primary/20 bg-bg-secondary/90 p-6 sm:p-10 shadow-lg backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/90">
          <div class="mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-lighter mb-3">
              <Sparkles size={13} /> 官方授权直营通道
            </span>
            <h1 class="font-brand text-3xl sm:text-4xl font-bold text-neutral-900 dark:text-neutral-100">
              30 秒快速开通专属专线
            </h1>
            <p class="mt-2 text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
              统一安全认证体系，开通即刻获取专属 IEPL 物理专线订阅及全平台自研客户端。
            </p>
          </div>

          <!-- Direct Authorized Registration Box -->
          <div class="p-5 rounded-2xl bg-gradient-to-br from-primary/5 via-blue-50/10 to-primary/10 border border-primary/25 mb-6 text-center">
            <div class="flex items-center justify-center gap-2 mb-2 text-primary font-bold text-sm">
              <ShieldCheck class="w-4 h-4 text-emerald-500" />
              <span>全节点 ×1 真实倍率 · 零虚标保障</span>
            </div>
            <p class="text-xs text-neutral-600 dark:text-neutral-300 mb-5">
              点击下方按钮前往官方统一开通系统，完成邮箱注册即可自选套餐。年付折合仅需 8.25 元/月起。
            </p>
            <Button
              url={siteConfig.registerUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              type="fill"
              className="w-full justify-center text-sm sm:text-base font-bold py-3.5 shadow-md"
            >
              <Zap class="w-4 h-4 text-accent" /> 立即前往官方授权注册通道 <ArrowRight size={16} />
            </Button>
            <p class="mt-2.5 text-[11px] text-neutral-400 dark:text-neutral-500">
              * 支持微信、支付宝快捷安全结算，开通即刻自动生效
            </p>
          </div>

          <!-- Feature highlights -->
          <div class="space-y-2.5 border-t border-dashed border-neutral-200 dark:border-neutral-700 pt-5 text-xs text-neutral-600 dark:text-neutral-300">
            <div class="flex items-center gap-2">
              <CheckCircle class="w-4 h-4 text-emerald-500 flex-shrink-0" />
              <span>不限制在线客户端数量，手机/平板/电脑同时在线</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle class="w-4 h-4 text-emerald-500 flex-shrink-0" />
              <span>覆盖香港、台湾、日本、新加坡、欧美等多国原生住宅 IP</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle class="w-4 h-4 text-emerald-500 flex-shrink-0" />
              <span>深度解锁 ChatGPT / Claude 与海外 4K 流媒体</span>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-dashed border-neutral-200 dark:border-neutral-700 text-center text-xs text-neutral-500 dark:text-neutral-400">
            已有账号？
            <a href="/sign-in" class="font-bold text-primary hover:underline ml-1">直接登录</a>
            <span class="mx-2">·</span>
            <a href="/#pricing" class="font-bold text-neutral-700 dark:text-neutral-300 hover:text-primary">查看套餐对比</a>
          </div>
        </div>
      </div>

      <!-- Right: Value Proposition Column -->
      <div
        class="hidden lg:block pl-6"
        data-aos="fade-up-xs"
        data-aos-once="true"
      >
        <div class="max-w-md">
          <p class="mb-3 inline-flex rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary dark:text-primary-lighter">
            2020 稳定运营
          </p>
          <h2 class="font-brand text-4xl leading-tight font-bold text-neutral-900 dark:text-neutral-100">
            拒绝晚高峰卡顿，拥抱高标准企业专线
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
            告别传统广播机房的频繁掉线与账号风控。精选企业级 IEPL 物理专线与新一代 VLESS 现代协议，保障您在海外业务与 AI 交互中的极致流畅。
          </p>
        </div>

        <div class="mt-8 max-w-md border-y border-dashed border-neutral-200 py-6 dark:border-neutral-700 space-y-4">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-lighter flex-shrink-0">
              <Zap size={16} />
            </span>
            <div>
              <h3 class="text-sm font-bold text-neutral-800 dark:text-neutral-100">超低延迟物理专线直连</h3>
              <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
                沪港、京德专线直达，单节点最高 2.5Gbps 带宽，晚高峰无惧公网阻断。
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="mt-0.5 flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-lighter flex-shrink-0">
              <Lock size={16} />
            </span>
            <div>
              <h3 class="text-sm font-bold text-neutral-800 dark:text-neutral-100">严格零日志（No-Logs）规范</h3>
              <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
                全节点物理内存无盘化运行，绝不记录用户访问内容与行为记录，保护数据隐私。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
