---
import { ArrowRight, ShieldCheck, Zap, Laptop, Smartphone } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title={`登录账户与管理订阅 — ${siteConfig.title}`}
  description="登录您的 NordVPN 官方专线账户，管理订阅套餐、下载最新跨平台客户端及获取节点订阅链接。"
>
  <main class="site-container py-12 md:py-20">
    <section class="max-w-md mx-auto" data-aos="fade-up-xs" data-aos-once="true">
      <div class="rounded-3xl border border-primary/20 bg-bg-secondary/90 p-6 sm:p-10 shadow-lg backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/90 text-center">
        <div class="mb-6">
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-lighter mb-3">
            <ShieldCheck size={14} /> 用户控制台
          </span>
          <h1 class="font-brand text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            登录专线管理中心
          </h1>
          <p class="mt-2 text-xs sm:text-sm text-neutral-500 dark:text-neutral-400">
            在用户中心可随时下载跨平台自研客户端、复制通用订阅及查看实时流量统计。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-neutral-50 dark:bg-neutral-800/60 border border-neutral-200 dark:border-neutral-700 mb-6 space-y-3">
          <p class="text-xs text-neutral-600 dark:text-neutral-300">
            请前往官方统一授权认证系统完成登录：
          </p>
          <Button
            url={siteConfig.registerUrl}
            target="_blank"
            rel="nofollow sponsored noopener noreferrer"
            type="fill"
            className="w-full justify-center text-sm font-bold py-3"
          >
            <Zap class="w-4 h-4 text-accent" /> 进入官方用户中心 / 登录 <ArrowRight size={15} />
          </Button>
        </div>

        <div class="grid grid-cols-2 gap-3 text-xs text-neutral-600 dark:text-neutral-300 border-t border-dashed border-neutral-200 dark:border-neutral-700 pt-5">
          <div class="p-3 rounded-xl bg-bg-primary dark:bg-neutral-900/60 border border-neutral-200/60 dark:border-neutral-700/60">
            <Laptop class="w-5 h-5 text-primary mx-auto mb-1" />
            <span>Windows / Mac 客户端</span>
          </div>
          <div class="p-3 rounded-xl bg-bg-primary dark:bg-neutral-900/60 border border-neutral-200/60 dark:border-neutral-700/60">
            <Smartphone class="w-5 h-5 text-primary mx-auto mb-1" />
            <span>iOS / Android 客户端</span>
          </div>
        </div>

        <div class="mt-6 pt-5 border-t border-dashed border-neutral-200 dark:border-neutral-700 text-xs text-neutral-500">
          还没有账户？
          <a href={siteConfig.registerUrl} target="_blank" rel="nofollow sponsored noopener noreferrer" class="font-bold text-primary hover:underline ml-1">
            立即注册开通
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
