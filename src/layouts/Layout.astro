---
import Meta from './Meta.astro';
import TopBg from "@/components/ui/TopBg.astro";
import Footer from "@/components/sections/Footer.astro";
import Header from "@/components/sections/Header.astro";
import TrackGa from "@/components/widgets/TrackGa.astro";

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	keywords?: string | undefined;
	robots?: string | undefined;
	ogImage?: string | undefined;
	canonical?: string | undefined;
	ogType?: 'website' | 'article' | undefined;
	publishedTime?: string | Date | undefined;
	modifiedTime?: string | Date | undefined;
	author?: string | undefined;
	category?: string | undefined;
	tags?: string[] | undefined;
}

const {
	title,
	description,
	keywords,
	robots,
	ogImage,
	canonical,
	ogType,
	publishedTime,
	modifiedTime,
	author,
	category,
	tags,
} = Astro.props;

import "../styles/global.css";
import "aos/dist/aos.css";
import "../styles/aos-custom.css";
import '../styles/article.css';
import '../styles/article-enhancements.css';
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <Meta
      title={title}
      description={description}
      keywords={keywords}
      robots={robots}
      ogImage={ogImage}
      canonical={canonical}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      category={category}
      tags={tags}
    />
    <TrackGa />
    <!-- Used to add dark mode right away, adding here prevents any flicker -->
    <script is:inline>
      if (typeof Storage !== 'undefined') {
        if (
          localStorage.getItem('dark_mode') &&
          localStorage.getItem('dark_mode') == 'true'
        ) {
          document.documentElement.classList.add('dark')
        }
      }
    </script>
  </head>
  <body class="overflow-x-hidden min-h-screen bg-bg-primary text-neutral-800 dark:bg-bg-primary-dark dark:text-neutral-200">
    <TopBg />
    <Header />
    <slot />
    <Footer />
    <script src="../assets/js/main.js"></script>
  </body>
</html>
