---
import Button from "@/components/ui/Button.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import { siteConfig, pricingPlans } from "@/config/site";
import { Check, ArrowRight, Sparkles, Shield } from "@lucide/astro";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const {
  title = "官方认证套餐方案 · 透明定价",
  description = "全节点采用真实企业级专线与 VLESS 协议，全节点 ×1 倍率计费，无任何隐藏限制。根据您的使用场景灵活选择。",
  showHeader = true,
} = Astro.props;
---

<section id="pricing" class="pricing-section py-16 md:py-24">
  {showHeader && (
    <div class="site-container mb-12" data-aos="fade-up-xs" data-aos-once="true">
      <SectionHeader title={title} description={description} />
    </div>
  )}

  <!-- Pricing Cards (4-column responsive grid) -->
  <div class="site-container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {pricingPlans.map((plan, i) => (
        <div
          class={`relative flex flex-col justify-between p-6 rounded-2xl border transition-all duration-300 hover:shadow-xl ${
            plan.popular
              ? 'border-primary ring-2 ring-primary/30 shadow-lg scale-[1.02] bg-gradient-to-b from-bg-secondary to-blue-50/20 dark:from-bg-secondary-dark dark:to-blue-950/20'
              : 'border-primary/15 dark:border-neutral-700 bg-bg-secondary dark:bg-bg-secondary-dark hover:border-primary/40'
          }`}
          data-aos="fade-up-sm"
          data-aos-delay={i * 100}
          data-aos-once="true"
        >
          {plan.popular && (
            <div class="popular-badge absolute -top-3.5 left-1/2 -translate-x-1/2 z-10 whitespace-nowrap">
              <span class="popular-badge__pill">
                <Sparkles class="w-3.5 h-3.5" stroke-width={2.25} />
                <span class="popular-badge__label font-brand">官方主力推荐</span>
              </span>
            </div>
          )}

          <div>
            <!-- Top tag / badge -->
            <div class="flex items-center justify-between mb-3">
              <span class={`inline-block px-2.5 py-0.5 rounded-full text-[11px] font-medium tracking-wide ${
                plan.popular 
                  ? 'bg-primary text-white font-semibold' 
                  : 'bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-lighter'
              }`}>
                {plan.badge}
              </span>
              <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-mono">
                {plan.traffic}
              </span>
            </div>

            <!-- Plan Name -->
            <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 mb-2 leading-snug">
              {plan.name}
            </h3>

            <!-- Price & billing cycle -->
            <div class="mb-4 pb-4 border-b border-dashed border-neutral-200 dark:border-neutral-700">
              <div class="flex items-baseline gap-1">
                <span class="text-sm font-medium text-neutral-500 dark:text-neutral-400">¥</span>
                <span class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 font-brand">
                  {plan.price}
                </span>
                <span class="text-xs text-neutral-500 dark:text-neutral-400 ml-1">
                  {plan.priceUnit.includes('/') ? plan.priceUnit.replace('元', '') : '/ 次'}
                </span>
              </div>
              <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-1 font-medium">
                {plan.monthlyEquivalent}
              </p>
              <p class="text-[11px] text-neutral-400 dark:text-neutral-500 mt-0.5">
                {plan.billingCycle}
              </p>
            </div>

            <!-- Key Specs Box -->
            <div class="rounded-xl bg-neutral-50 dark:bg-neutral-800/50 p-3 mb-5 text-[12px] space-y-2 border border-neutral-100 dark:border-neutral-700/50">
              <div class="flex items-start gap-1.5">
                <span class="text-neutral-400 flex-shrink-0">流量：</span>
                <span class="font-medium text-neutral-700 dark:text-neutral-200">{plan.trafficDesc}</span>
              </div>
              <div class="flex items-start gap-1.5">
                <span class="text-neutral-400 flex-shrink-0">线路：</span>
                <span class="font-medium text-neutral-700 dark:text-neutral-200">{plan.lineType}</span>
              </div>
              <div class="flex items-start gap-1.5">
                <span class="text-neutral-400 flex-shrink-0">设备：</span>
                <span class="font-medium text-emerald-600 dark:text-emerald-400">{plan.devices}</span>
              </div>
              <div class="flex items-start gap-1.5">
                <span class="text-neutral-400 flex-shrink-0">折扣：</span>
                <span class="font-medium text-primary dark:text-primary-light">{plan.discountInfo}</span>
              </div>
            </div>

            <!-- Checklist -->
            <ul class="space-y-2.5 mb-6 text-xs">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <Check class="w-4 h-4 text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-neutral-600 dark:text-neutral-300 leading-snug">
                    {feature.text}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom CTA -->
          <div class="mt-4 pt-4 border-t border-dashed border-neutral-200 dark:border-neutral-700">
            <Button
              url={siteConfig.registerUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              type={plan.popular ? "fill" : "outline"}
              className="w-full justify-center text-sm font-semibold py-2.5"
            >
              {plan.ctaText} <ArrowRight size={14} />
            </Button>
            <p class="text-center text-[10px] text-neutral-600 dark:text-neutral-400 mt-2">
              授权直达 · 实时激活
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Pricing Bottom Notice / Reassurance -->
    <div class="mt-10 p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-dashed border-primary/20 text-xs text-neutral-500 dark:text-neutral-400 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <Shield class="w-5 h-5 text-primary flex-shrink-0" />
        <span><strong>线路服务保障：</strong>所有套餐均为全节点 ×1 真实倍率，提供 7×24h 自动化运维监控。支持自研客户端直接一键连接，或一键导入 Clash、Shadowrocket 等通用客户端。</span>
      </div>
      <a href="/contact" class="text-primary hover:underline font-medium whitespace-nowrap">
        咨询在线技术支持 →
      </a>
    </div>
  </div>
</section>

<style>
  /* ─── "Most Popular" badge ──────────────────────── */
  .popular-badge__pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    background: linear-gradient(
      120deg,
      var(--color-primary) 0%,
      color-mix(in oklab, var(--color-primary) 70%, var(--color-accent)) 55%,
      var(--color-accent) 100%
    );
    box-shadow:
      0 6px 18px -6px color-mix(in oklab, var(--color-primary) 65%, transparent),
      0 2px 6px -2px color-mix(in oklab, var(--color-accent) 50%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    isolation: isolate;
    overflow: hidden;
  }

  .popular-badge__pill::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.55),
      rgba(255, 255, 255, 0) 45%,
      rgba(255, 255, 255, 0.25)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }

  .popular-badge__pill::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 70%
    );
    transform: translateX(-120%);
    animation: popular-shine 4.5s ease-in-out 1s infinite;
    pointer-events: none;
  }

  .popular-badge__label {
    position: relative;
    z-index: 1;
    line-height: 1;
  }

  .popular-badge svg {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.15));
  }

  @keyframes popular-shine {
    0%        { transform: translateX(-120%); }
    55%, 100% { transform: translateX(220%); }
  }

  :global(.dark) .popular-badge__pill {
    box-shadow:
      0 8px 22px -6px color-mix(in oklab, var(--color-primary) 80%, transparent),
      0 2px 8px -2px color-mix(in oklab, var(--color-accent) 55%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .popular-badge__pill::after {
      animation: none;
    }
  }
</style>
