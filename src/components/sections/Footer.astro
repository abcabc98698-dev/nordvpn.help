---
import Logo from "@/components/ui/Logo.astro";
import ToTop from "@/components/widgets/ToTop.astro";
import { siteConfig, footerLinks } from "@/config/site.js";
import { ShieldCheck, Activity } from "@lucide/astro";

const currentYear = new Date().getFullYear();
---

<footer class="text-neutral-700 dark:text-neutral-300 border-t mt-20 md:mt-32 border-dashed border-primary/20 dark:border-neutral-700/60 bg-bg-secondary/40 dark:bg-neutral-900/40">
  <div class="container mx-auto px-6 max-w-7xl py-12 md:py-16">
    <!-- Top: Logo + Brand statement + 4 navigation columns -->
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-10 mb-12">
      <div class="max-w-md">
        <Logo />
        <p class="mt-4 text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
          NordVPN 品牌官方授权全球专线网络服务站（nordvpn.help），自 2020 年起稳定运营。专注提供全链路企业级 IEPL 物理专线与新一代 VLESS 现代协议，全节点 ×1 真实倍率，全天候保障 AI 工具与 4K 流媒体极速低时延互联。
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-neutral-600 dark:text-neutral-400">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-primary/10 text-primary border border-primary/20 dark:bg-primary/20 dark:text-primary-lighter font-medium">
            <ShieldCheck class="w-3.5 h-3.5" /> 官方授权认证
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-medium">
            <Activity class="w-3.5 h-3.5" /> 专线 SLA 99.98%
          </span>
        </div>
      </div>

      <!-- Four columns -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 md:gap-10 flex-1 lg:max-w-3xl">
        <!-- Product -->
        <div>
          <h4 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-neutral-900 dark:text-neutral-100 mb-4 font-sans">
            产品与服务
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-sm">
            {footerLinks.product.map((link) => (
              <li>
                <a
                  href={link.url}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "nofollow sponsored noopener noreferrer" : undefined}
                  class="text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Resources / Tutorials -->
        <div>
          <h4 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-neutral-900 dark:text-neutral-100 mb-4 font-sans">
            教程与指南
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-sm">
            {footerLinks.resources.map((link) => (
              <li>
                <a
                  href={link.url}
                  class="text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Company & Support -->
        <div>
          <h4 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-neutral-900 dark:text-neutral-100 mb-4 font-sans">
            品牌与支持
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-sm">
            {footerLinks.company.map((link) => (
              <li>
                <a
                  href={link.url}
                  class="text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Legal & SLA -->
        <div>
          <h4 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-neutral-900 dark:text-neutral-100 mb-4 font-sans">
            合规与条款
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-sm">
            {footerLinks.legal.map((link) => (
              <li>
                <a
                  href={link.url}
                  class="text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Affiliate & Authorized Promotion Disclosure -->
    <div class="border-t border-dashed border-primary/10 dark:border-neutral-800 py-4 mb-8 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed bg-primary/5 dark:bg-neutral-800/30 rounded-lg p-4">
      <p class="font-semibold text-neutral-700 dark:text-neutral-300 mb-1">
        推广披露与服务声明
      </p>
      <p>
        本站属于 NordVPN 品牌官方授权全球推广与技术指导站。页面中包含通往官方控制台与结算中心的直达链接。通过本站渠道注册不会产生任何额外支出，您将享有官方同等退款承诺与专属节点服务。站内线路测试数据均来自工程团队真实监测，旨在提供客观参考。
      </p>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-dashed border-primary/10 dark:border-neutral-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400">
      <p>
        © 2020 - {currentYear} <a href="/" class="hover:text-primary font-medium">{siteConfig.author}</a>（nordvpn.help）. 保留所有权利。
      </p>

      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-dashed border-primary/30 text-primary dark:text-primary-light font-mono text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          IEPL 骨干专线节点全线运行正常
        </span>
        <a href="/status" class="hover:text-primary transition-colors">实时状态</a>
        <a href="/privacy" class="hover:text-primary transition-colors">隐私保护</a>
        <a href="/terms" class="hover:text-primary transition-colors">使用协议</a>
      </div>
    </div>
  </div>
</footer>

<!-- Back to top -->
<ToTop />
