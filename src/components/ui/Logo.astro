---
interface Props {
  showBadge?: boolean;
}

const { showBadge = true } = Astro.props;
---

<a
  href="/"
  class="group relative z-30 flex items-center gap-2 sm:gap-2.5 transition-transform duration-200 hover:scale-[1.02] shrink-0 min-w-max select-none"
  aria-label="NordVPN 官方授权服务站"
>
  <div class="relative flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 lg:w-10 lg:h-10 rounded-xl bg-gradient-to-br from-[#0052cc] via-[#2d6dc3] to-[#003882] shadow-sm border border-blue-400/30 overflow-hidden shrink-0">
    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- NordVPN Mountain / Shield Glyph -->
      <path d="M12 2L3 6V12C3 17.5 6.8 22.6 12 24C17.2 22.6 21 17.5 21 12V6L12 2Z" fill="white" fill-opacity="0.2" />
      <path d="M12 4L5 7.5V12C5 16.3 8 20.3 12 21.6C16 20.3 19 16.3 19 12V7.5L12 4Z" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M7.5 15L10.5 10L13.5 15L16.5 9" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <div class="absolute inset-0 bg-gradient-to-t from-white/0 via-white/10 to-white/20 pointer-events-none"></div>
  </div>
  <div class="flex flex-col shrink-0">
    <div class="flex items-center gap-1.5">
      <span class="text-base sm:text-lg font-bold tracking-tight text-neutral-900 dark:text-neutral-50 font-sans whitespace-nowrap">
        Nord<span class="text-primary dark:text-primary-light">VPN</span>
      </span>
      {showBadge && (
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-primary/10 text-primary border border-primary/20 dark:bg-primary/20 dark:text-primary-lighter whitespace-nowrap">
          官方授权
        </span>
      )}
    </div>
    <span class="hidden xl:block text-[10px] tracking-wider text-neutral-500 dark:text-neutral-400 -mt-0.5 whitespace-nowrap">
      IEPL 专线服务站
    </span>
  </div>
</a>
