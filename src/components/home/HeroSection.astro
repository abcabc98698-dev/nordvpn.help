---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, Activity, Zap, CheckCircle } from "@lucide/astro";

// 真实透明网络运行遥测（动态轮巡，体现真实专线监控）
const stats = [
  { label: "IEPL专线延迟", value: "22ms", delta: "沪港专线直连", cycle: ["22ms", "24ms", "21ms", "23ms"] },
  { label: "骨干网络速率", value: "2.5 Gbps", delta: "全节点 ×1 倍率", cycle: ["2.5 Gbps", "2.4 Gbps", "2.5 Gbps", "2.5 Gbps"] },
  { label: "专线服务SLA", value: "99.98%", delta: "2020持续稳定", cycle: ["99.98%", "99.99%", "99.98%", "100%"] },
  { label: "全球优质节点", value: "50+ 节点", delta: "原生住宅 IP", cycle: ["50+ 节点", "52 节点", "50+ 节点", "51 节点"] },
];

const bars = [35, 48, 55, 68, 72, 85, 92];
const barCycles = JSON.stringify([
  [35, 48, 55, 68, 72, 85, 92],
  [40, 52, 60, 75, 80, 88, 95],
  [32, 45, 58, 70, 78, 86, 90],
  [38, 50, 62, 72, 82, 89, 94],
]);
---

<div class="relative site-container z-20 w-full mx-auto mt-16 px-4 md:mt-18 lg:mt-28 xl:px-0">
  <div class="relative w-full px-2 sm:px-4 flex flex-col items-center justify-between md:flex-row mb-16 gap-8">
    <!-- Left: Brand Value & Conversion -->
    <div class="relative w-full md:max-w-[560px] md:w-1/2 text-center sm:text-left sm:-mt-4">
      <!-- Badges -->
      <div
        class="flex flex-wrap gap-2 justify-center sm:justify-start mb-5"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Badge variant="primary">2020 稳定运营</Badge>
        <Badge variant="accent">IEPL 企业内网专线</Badge>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          官方授权直达
        </span>
      </div>

      <!-- Main Title -->
      <h1 class="mb-4">
        <span class="block text-sm sm:text-base font-semibold tracking-wider uppercase text-primary mb-2">
          NordVPN 品牌官方授权专线站 · nordvpn.help
        </span>
        <AnimatedText
          content="企业级 IEPL 专线网络 全球极速无界互联"
          delay={0.1}
          duration={0.5}
          stagger={0.06}
          class="text-3xl text-neutral-900 dark:text-neutral-50 leading-tight md:text-4xl lg:text-5xl font-brand font-semibold"
        />
      </h1>

      <!-- Subtitle -->
      <div class="mb-6">
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
          自 2020 年起长效运营，精选全节点企业级内网 <strong>IEPL 专线</strong> 与新一代 <strong>VLESS 协议</strong>。单节点最高 2.5Gbps，晚高峰超低时延不卡顿。全面适配 ChatGPT / Claude / Midjourney 深度对话、Netflix / TikTok 4K 直播及海外电商出海。
        </p>
      </div>

      <!-- Highlights / Trust Points -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-2.5 mb-7 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300">
        <div class="flex items-center gap-1.5">
          <CheckCircle class="w-4 h-4 text-primary flex-shrink-0" />
          <span>全节点固定 1x 倍率，无隐藏套路</span>
        </div>
        <div class="flex items-center gap-1.5">
          <CheckCircle class="w-4 h-4 text-primary flex-shrink-0" />
          <span>不限设备数量，多端同时在线</span>
        </div>
        <div class="flex items-center gap-1.5">
          <CheckCircle class="w-4 h-4 text-primary flex-shrink-0" />
          <span>自研客户端 + Clash/Shadowrocket</span>
        </div>
        <div class="flex items-center gap-1.5">
          <CheckCircle class="w-4 h-4 text-primary flex-shrink-0" />
          <span>年付低至 ¥8.25/月，7×24h 专线运维</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div
        class="flex flex-wrap gap-3 justify-center sm:justify-start"
        data-aos="fade-up-sm"
        data-aos-delay="500"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Button url={siteConfig.registerUrl} type="fill" target="_blank" rel="nofollow sponsored noopener noreferrer" className="text-base px-6 py-3 font-semibold shadow-md">
          <Zap class="w-4 h-4 text-accent" /> 立即开通专线网络
        </Button>
        <Button url="/#pricing" type="solid" className="text-base px-6 py-3">
          查看套餐方案 <ArrowRight size={16} />
        </Button>
      </div>

      <p class="mt-3 text-[11px] text-neutral-600 dark:text-neutral-400">
        * 注：8.25 元/月为轻量版年付折算单价，全站注册链接统一安全防损跳转。
      </p>
    </div>

    <!-- Right: Real-time Telemetry Dashboard (Live Backbone Status) -->
    <div
      class="relative justify-end w-full mt-8 md:flex md:pl-6 md:w-1/2 md:mt-0"
      data-aos="fade-left-sm"
      data-aos-delay="250"
      data-aos-duration="700"
      data-aos-once="true"
    >
      <BrowserFrame url="telemetry.nordvpn.help/backbone-live" className="w-full">
        <div class="p-5 md:p-6 h-[330px] md:h-[370px] flex flex-col gap-4">
          <!-- Toolbar -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="hero-live-dot relative w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-semibold text-neutral-800 dark:text-neutral-200">
                IEPL 企业骨干链路实时遥测
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-primary/10 text-primary dark:text-primary-light font-medium">
                VLESS 协议直连
              </span>
              <div class="w-5 h-1.5 rounded-full bg-emerald-500/80"></div>
            </div>
          </div>

          <!-- 2x2 Stat grid -->
          <div class="grid grid-cols-2 gap-3 flex-1">
            {stats.map((stat, i) => (
              <div class="rounded-xl border border-primary/15 dark:border-neutral-700 bg-bg-primary/60 dark:bg-neutral-800/60 p-3 flex flex-col justify-between hover:border-primary/40 transition-colors">
                <span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400">{stat.label}</span>
                <div class="flex items-end justify-between mt-2">
                  <span
                    class="hero-stat-value text-lg md:text-xl font-brand font-bold text-neutral-900 dark:text-neutral-100 leading-none"
                    data-cycle={stat.cycle.join("|")}
                    style={`animation-delay: ${i * 400}ms;`}
                  >{stat.value}</span>
                  <span
                    class="hero-delta text-[10px] font-medium text-emerald-600 dark:text-emerald-400"
                    style={`animation-delay: ${i * 600}ms;`}
                  >{stat.delta}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Mini chart: Latency and Throughput stability -->
          <div class="rounded-xl border border-primary/15 dark:border-neutral-700 bg-bg-primary/60 dark:bg-neutral-800/60 p-3">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-1.5">
                <Activity class="w-3.5 h-3.5 text-primary" />
                <span class="text-[11px] font-medium text-neutral-700 dark:text-neutral-300">晚高峰 24h 丢包率 & 专线吞吐</span>
              </div>
              <span class="text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">丢包率 0.00%</span>
            </div>
            <div
              class="flex items-end gap-1.5 h-10 hero-bars"
              data-bar-cycles={barCycles}
            >
              {bars.map((h, i) => (
                <div
                  class:list={[
                    "hero-bar flex-1 rounded-sm origin-bottom",
                    i === bars.length - 1 ? "bg-primary hero-bar-active" : "bg-primary/25 dark:bg-primary/35",
                  ]}
                  style={`--bar-h: ${h}%; height: ${h}%; animation-delay: ${i * 90}ms;`}
                ></div>
              ))}
            </div>
          </div>
        </div>
      </BrowserFrame>
    </div>
  </div>
</div>

<style>
  /* ─── Live ping dot ─────────────────── */
  .hero-live-dot::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: currentColor;
    color: rgb(16, 185, 129);
    animation: hero-live-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes hero-live-ping {
    0%   { transform: scale(1);   opacity: 0.7; }
    80%, 100% { transform: scale(3); opacity: 0; }
  }

  .hero-stat-value {
    transition: opacity 200ms ease, transform 200ms ease;
    display: inline-block;
  }
  .hero-stat-value.is-flashing {
    opacity: 0.35;
    transform: translateY(2px);
  }

  .hero-delta {
    animation: hero-delta-pulse 2.4s ease-in-out infinite;
  }
  @keyframes hero-delta-pulse {
    0%, 100% { opacity: 1;   filter: drop-shadow(0 0 0 transparent); }
    50%      { opacity: 0.75; filter: drop-shadow(0 0 4px rgba(16, 185, 129, 0.5)); }
  }

  .hero-bar {
    animation: hero-bar-rise 700ms cubic-bezier(0.4, 0, 0.2, 1) backwards;
    transition: height 900ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  @keyframes hero-bar-rise {
    from { height: 0 !important; opacity: 0; }
    to   { opacity: 1; }
  }

  .hero-bar-active {
    animation:
      hero-bar-rise 700ms cubic-bezier(0.4, 0, 0.2, 1) backwards,
      hero-bar-glow 2.6s ease-in-out 1.2s infinite;
  }
  @keyframes hero-bar-glow {
    0%, 100% { transform: scaleY(1);    filter: brightness(1); }
    50%      { transform: scaleY(0.93); filter: brightness(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-live-dot::before,
    .hero-delta,
    .hero-bar,
    .hero-bar-active,
    .hero-stat-value {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Cycle stat values on a stagger (live-data feel)
  document.querySelectorAll<HTMLElement>('.hero-stat-value').forEach((el, i) => {
    const cycleAttr = el.dataset.cycle;
    if (!cycleAttr) return;
    const values = cycleAttr.split('|');
    if (values.length < 2) return;
    let idx = 0;
    setInterval(() => {
      idx = (idx + 1) % values.length;
      el.classList.add('is-flashing');
      window.setTimeout(() => {
        el.textContent = values[idx];
        el.classList.remove('is-flashing');
      }, 200);
    }, 3200 + i * 700);
  });

  const heroBarsHost = document.querySelector<HTMLElement>('.hero-bars');
  const heroBars = document.querySelectorAll<HTMLElement>('.hero-bar');
  if (heroBarsHost && heroBars.length > 0) {
    try {
      const cycles = JSON.parse(heroBarsHost.dataset.barCycles || '[]') as number[][];
      if (cycles.length > 1) {
        let cycleIdx = 0;
        window.setTimeout(() => {
          window.setInterval(() => {
            cycleIdx = (cycleIdx + 1) % cycles.length;
            const next = cycles[cycleIdx];
            heroBars.forEach((b, i) => {
              if (typeof next[i] === 'number') {
                b.style.height = `${next[i]}%`;
              }
            });
          }, 2400);
        }, 1500);
      }
    } catch {
      /* swallow JSON parse errors silently */
    }
  }
</script>
